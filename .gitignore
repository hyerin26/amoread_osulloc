# 날짜별 백업 폴더 — git 기록이 대신한다
workspace/_backup_*/
# 디자이너 전달 압축본 (풀린 폴더는 기록)
handoff/*.zip*
# 내부 데이터(판매실적·원가·리뷰 등) — 기록에 남기지 않는다
workspace/amoread_app/data/
# 앱 자체 제외 목록(.venv, planner/data, output, .env, __pycache__)은 workspace/amoread_app/.gitignore
# 디자이너 전달본 안의 코드 사본에도 같은 데이터가 있다
handoff/**/data/
# 설치된 외부 스킬(skills-lock.json으로 복원 가능)
.agents/
# 목업 공유본 (plans/mockups/공유용_묶기.py로 다시 만들 수 있음, 글꼴이 들어 있어 큼)
handoff/목업_공유_*/
handoff/AMOREAD_v2_*/
