# 이 파일을 복사해 이름을 .env 로 바꾸고 = 뒤에 값을 붙여 넣으세요. (.env는 git에 올라가지 않습니다)
# 키는 이 파일에만 둡니다. 코드·문서·채팅·공유 파일에 쓰지 마세요. 받는 법: plans/22 §3

# 네이버 개발자센터 앱 (검색 + 데이터랩 검색어트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 (도구 › API 사용 관리): 액세스 라이선스 / 비밀키 / 광고계정 번호
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=
